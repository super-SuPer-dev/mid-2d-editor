[sub_resource type="Shader" id="Shader_repeat_frame"]
code = "shader_type canvas_item;\n\nconst float FRAME_COUNT = 3.0;\nconst float BASE_SCALE_X = 0.13812155;\nvarying float horizontal_repeat;\n\nvoid vertex() {\n\thorizontal_repeat = max(length(MODEL_MATRIX[0].xy) / BASE_SCALE_X, 1.0);\n}\n\nvoid fragment() {\n\tfloat frame_slot = clamp(floor(UV.x * FRAME_COUNT + 0.0001), 0.0, FRAME_COUNT - 1.0);\n\tfloat local_x = UV.x * FRAME_COUNT - frame_slot;\n\tlocal_x = fract((local_x - 0.5) * horizontal_repeat + 0.5);\n\tvec2 tiled_uv = vec2((frame_slot + local_x) / FRAME_COUNT, UV.y);\n\tCOLOR = texture(TEXTURE, tiled_uv) * COLOR;\n}\n"

