[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/screens/character_upgrades.gd" id="1_script"]
[ext_resource type="Theme" path="res://Scenes/ui/field_theme.tres" id="2_theme"]
[ext_resource type="Texture2D" path="res://Assets/Images/Background/1.png" id="3_background"]

[node name="CharacterUpgrades" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Background" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = ExtResource("3_background")
expand_mode = 1
stretch_mode = 6

[node name="Shade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.02, 0.045, 0.07, 0.72)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
